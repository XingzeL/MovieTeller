# Example environment variables for MovieTeller (copy to `.env` at repo root).
# Never commit `.env` — it is gitignored.

# -----------------------------------------------------------------------------
# API keys — PREFIX_* or legacy aliases; multi-provider URLs/catalog 建议写在 ``config/local.yaml``。
# 亦可用 API_KEYS_JSON / API_BASE_URLS_JSON / NARRATION_*_JSON（单行 JSON，优先级高于 YAML）。
#
# 1) API_KEYS_JSON — arbitrary provider slug -> secret (overrides YAML when set).
#    Example: {"modelscope":"$MODELSCOPE_API_KEY_FREE","openai":"${OPENAI_API_KEY}"}
API_KEYS_JSON={"modelscope":"$MODELSCOPE_API_KEY_FREE"}

# 2) PREFIX_API_KEY — uppercase PREFIX becomes slug ``prefix`` (lowercase).
#    OPENAI_API_KEY -> openai, AZURE_OPENAI_API_KEY -> azure_openai, VOLCENGINE_API_KEY -> volcengine
OPENAI_API_KEY=

# Rare legacy names that are not PREFIX_API_KEY (still supported):
# MODELSCOPE_API_KEY_FREE / ELEVEN_LABS_API — see movieteller_config loader.

# -----------------------------------------------------------------------------
# ModelScope 示例（provider slug 固定为 ``modelscope``；密钥勿写入 JSON 明文）
#
# 1) 只在这一行填真实 token（或放进 CI / 系统环境变量）：
# MODELSCOPE_API_KEY_FREE=
#
# 2) 其余可用下列一组（取消注释即可）：
# API_KEYS_JSON={"modelscope":"$MODELSCOPE_API_KEY_FREE"}
# API_BASE_URLS_JSON={"modelscope":"https://api-inference.modelscope.cn/v1/chat/completions"}
# NARRATION_PROVIDER_MODELS_JSON={"modelscope":"qwen/Qwen-VL-Max"}
# NARRATION_IMAGE_MODEL=qwen/Qwen-VL-Max
#
# 若 HTTP 客户端自带路径 ``/chat/completions``，可把 BASE 改成仅含 ``/v1``：
# https://api-inference.modelscope.cn/v1

# -----------------------------------------------------------------------------
# Provider URLs / keys / model catalogs — 推荐 ``config/local.yaml``（多行 YAML）。
# 以下为可选 env 单行 JSON 覆盖（优先级高于 local.yaml）：
#
# API_KEYS_JSON={"modelscope":"$MODELSCOPE_API_KEY_FREE","volcengine":"$VOLCENGINE_API_KEY"}
# API_BASE_URLS_JSON={"modelscope":"https://api-inference.modelscope.cn/v1","volcengine":"https://ark.cn-beijing.volces.com/api/v3"}
# NARRATION_PROVIDER_MODEL_CATALOG_JSON={"volcengine":["doubao-seed-1-6-vision-250815"],"modelscope":["Qwen/Qwen3-VL-30B-A3B-Instruct"]}
# NARRATION_POLISH_PROVIDER_MODEL_CATALOG_JSON={"dashscope":["qwen-turbo","qwen2.5-7b-instruct"],"glm":["glm-4.7-flash"]}
#
# NARRATION_MODEL=...
# NARRATION_MODEL_INDEX=0
# NARRATION_PROVIDER_MODELS_JSON={"dashscope":"qwen3-vl-plus"}
# NARRATION_POLISH_ENABLED=false
# NARRATION_POLISH_PROVIDER=openai
# NARRATION_POLISH_MODEL=gpt-4.1-mini
# NARRATION_POLISH_MODEL_INDEX=0
# NARRATION_POLISH_PROVIDER_MODELS_JSON={"dashscope":"qwen-turbo"}
# NARRATION_POLISH_TARGET_WPM=150
# NARRATION_POLISH_CEFR_LEVEL=B1
# NARRATION_POLISH_STRENGTH=medium
# NARRATION_POLISH_SAFETY_MARGIN_SEC=0.2
# NARRATION_SPEECH_ENABLED=false
# NARRATION_SPEECH_PROVIDER=edge_tts
# NARRATION_SPEECH_VOICE=en-US-EmmaMultilingualNeural
# NARRATION_SPEECH_RATE=+0%
# NARRATION_SPEECH_VOLUME=+0%
# NARRATION_SPEECH_PITCH=+0Hz
# NARRATION_SPEECH_BOUNDARY=SentenceBoundary
# NARRATION_VIDEO_BACKGROUND_AUDIO_VOLUME=0.35
# NARRATION_VIDEO_SPEECH_AUDIO_VOLUME=1.0

# Global fallback model when a capability-specific model pool has no entry for that slug.
NARRATION_IMAGE_MODEL=qwen/Qwen-VL-Max
# Alternative env name supported by loaders:
# IMAGE_MODEL=gpt-4o-mini

# Which provider slug narration uses (must exist in api_keys / API_KEYS_JSON). Env: NARRATION_PROVIDER
# NARRATION_PROVIDER=modelscope

# pytest 集成测试 ``test_example_mp4_first_5s_narration_api`` 专用（movieteller_config 不读取此项）：
# 设为 1 才会请求真实多模态 API（计费）。平时不要写进 .env；需要时在终端前缀：
#   RUN_NARRATION_API_TEST=1 python3 -m pytest ...
# 若坚持写在 .env，本地每次 pytest 都会尝试跑该用例。
# RUN_NARRATION_API_TEST=1

MAX_FRAMES_PER_SEGMENT=24
# Longest side after scale (Python narration ffmpeg); fits inside edge×edge box
NARRATION_FRAME_MAX_EDGE=768
FFMPEG_PATH=ffmpeg
DEFAULT_PROMPT_STYLE=documentary

# Optional custom YAML path (overrides packaged defaults; overridden by env above)
# MOVIE_TELLER_CONFIG=/absolute/path/to/custom.yaml

VIDEOCAPTIONER_BIN=
# Subtitle extraction (VideoCaptioner transcribe): ASR / language / timeout (ms); omit timeout for unlimited
# VIDEOCAPTIONER_ASR=bijian
# VIDEOCAPTIONER_LANGUAGE=auto
# VIDEOCAPTIONER_TRANSCRIBE_TIMEOUT_MS=600000
# Python interpreter for server-side extraction bridge
# MOVIE_TELLER_PYTHON=python3

NARRATION_API_URL=

# Server
PORT=3001

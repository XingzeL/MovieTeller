# Local overrides (merged after packaged default.yaml). Env vars override this file.
# Never commit secrets — this file is gitignored; copy from local.yaml.example.


default_prompt_style: movie_commentary
narration_polish_enabled: true
narration_tts_enabled: true
narration_polish_model_index: 2
narration_model_index: 0
narration_polish_target_wpm: 250  
narration_polish_cefr_level: B1   #CEFR等级为B1
narration_polish_strength: medium 
narration_polish_safety_margin_sec: 0.2

api_providers:
  newapi: "http://127.0.0.1:3000/v1"
  modelscope: "https://api-inference.modelscope.cn/v1"
api_keys:
  newapi: "$NEW_API_KEY_NARRATION_FREE"
model_catalog:
  - Qwen/Qwen3-VL-30B-A3B-Instruct
  - qwen2.5-7b-instruct
  - deepseek-v4-flash
  - qwen3-14b
  - qwen3-tts-flash
  - doubao-seed-2-0-mini-260428
  - glm-4v-flash   

embedding:
  - text-embedding-v4

# 以下的配置是给model_gateway使用，用于选择默认模型，功能模块无需关心
narration_model_default: "Qwen/Qwen3-VL-30B-A3B-Instruct"
polish_model_default: "qwen2.5-7b-instruct"
tts_model_default: "qwen3-tts-flash"
embedding_model_default: "text-embedding-v4"
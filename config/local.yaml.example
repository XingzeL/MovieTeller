# Copy this file to `local.yaml` in the same directory and fill in your values.
# `local.yaml` is gitignored — never commit it.
#
# Priority: environment variables > this file > packaged defaults.

# narration_image_model: gpt-4o-mini
# max_frames_per_segment: 24

# -----------------------------------------------------------------------------
# ModelScope（slug 一律用 ``modelscope``；密钥用占位符，真实值放在环境变量 MODELSCOPE_API_KEY_FREE）
#
# api_keys:
#   modelscope: "$MODELSCOPE_API_KEY_FREE"
# api_base_urls:
#   modelscope: "https://api-inference.modelscope.cn/v1/chat/completions"
# provider_models:
#   modelscope: "qwen/Qwen-VL-Max"
# narration_image_model: qwen/Qwen-VL-Max
#
# 若客户端自己会请求 ``.../v1/chat/completions``，可把 ``modelscope`` 的 URL 改为：
# https://api-inference.modelscope.cn/v1

# -----------------------------------------------------------------------------

# api_keys:
#   modelscope: "your-api-token"

# api_base_urls:
#   modelscope: https://api-inference.modelscope.cn/v1

# provider_models:
#   openai: gpt-4o
#   modelscope: qwen/Qwen-VL-Max
# 或用环境变量 PROVIDER_MODELS_JSON={"openai":"gpt-4o","modelscope":"qwen/..."}
